<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GAME REGION CALIBRATION"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_calibration_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Calibrate Golden Flower card showdown area"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_save_calibration"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#10B981"
        android:text="SAVE CALIBRATION"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/btn_reset_calibration"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:backgroundTint="#334155"
        android:text="RESET TO DEFAULT"
        android:layout_marginTop="8dp" />
</LinearLayout>
