<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#1E293B"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tv_item_round_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#104"
                android:textColor="#10B981"
                android:textStyle="bold"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tv_item_time"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="14:22:05"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginStart="8dp" />
            <TextView
                android:id="@+id/tv_item_hit_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIT ✓"
                android:textColor="#10B981"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">
            <TextView
                android:id="@+id/tv_item_winner"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Winner: Spot A"
                android:textColor="#FBBF24"
                android:textStyle="bold"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_item_detection_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verified"
                android:textColor="#10B981"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_item_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cards: K♠ | 8♥ | 3♦"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_item_prediction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pred: A (A:45% B:35% C:20%)"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
