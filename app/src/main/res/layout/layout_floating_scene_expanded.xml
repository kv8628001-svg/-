<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#E60F172A"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tv_round_count"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Round #--"
            android:textStyle="bold"
            android:textColor="#10B981"
            android:textSize="13sp" />
        <Button
            android:id="@+id/btn_minimize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="✕"
            android:textColor="#9CA3AF" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_current_cards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cards: Scanning..."
        android:textColor="#E2E8F0"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <!-- Probabilities Progress Bars -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tv_possible_a"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="A: 33%"
                android:textColor="#60A5FA"
                android:textSize="12sp"
                android:textStyle="bold" />
            <ProgressBar
                android:id="@+id/progress_a"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="33" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:id="@+id/tv_possible_b"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="B: 33%"
                android:textColor="#F472B6"
                android:textSize="12sp"
                android:textStyle="bold" />
            <ProgressBar
                android:id="@+id/progress_b"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="33" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <TextView
                android:id="@+id/tv_possible_c"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="C: 34%"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:textStyle="bold" />
            <ProgressBar
                android:id="@+id/progress_c"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="34" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_most_likely"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Most Likely: Spot A"
        android:textColor="#FBBF24"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tv_data_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Sufficient"
        android:textColor="#94A3B8"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tv_verified_accuracy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Verified Accuracy: 34.2%"
        android:textColor="#38BDF8"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tv_brier_score"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Brier Score: 0.655"
        android:textColor="#94A3B8"
        android:textSize="10sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="* Statistical frequency only. Not a guaranteed win."
        android:textColor="#E2E8F0"
        android:textSize="9sp"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <Button
            android:id="@+id/btn_scan"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:text="SCAN"
            android:textSize="11sp" />
        <Button
            android:id="@+id/btn_history"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:text="HIST"
            android:textSize="11sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>
</LinearLayout>
